{
  "name": "dsh-agent-status-bar",
  "version": "0.3.0",
  "description": "Shows what the main agent is doing on a slim bar above the taskbar while the DSH window is in the background.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "overlay",
    "locale",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "selfcheck": "node test/selfcheck.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "status-bar",
    "agent",
    "taskbar",
    "windows"
  ],
  "author": "yexiao130",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yexiao130/dsh-agent-status-bar.git"
  },
  "homepage": "https://github.com/yexiao130/dsh-agent-status-bar#readme",
  "bugs": {
    "url": "https://github.com/yexiao130/dsh-agent-status-bar/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  }
}
